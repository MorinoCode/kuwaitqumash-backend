# ============================================
# BACKEND ENVIRONMENT VARIABLES TEMPLATE
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git! (it's already in .gitignore)
#
# For local development:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your actual values
#   3. Start the server: npm run dev
#
# For production (Cloud Run):
#   - Environment variables are set in Cloud Run console
#   - Or via deploy-cloudrun.ps1 script
# ============================================

# ============================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================
# Local: Use localhost
# Production: Use Cloud SQL / Postgres service hostname
DB_NAME=kuwaitqumash_db
DB_USER=postgres
DB_PASS=your_local_database_password
DB_HOST=localhost
DB_PORT=5432
# Connection pool sizing (tune per service so API + workers stay well under Postgres max_connections)
# Recommended on single-node Postgres (max_connections=100): API=15/3, workers=5/1
DB_POOL_MAX=15
DB_POOL_MIN=3
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000
DB_STATEMENT_TIMEOUT_MS=30000

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# JWT CONFIGURATION (REQUIRED)
# ============================================
# Use a strong random secret for production!
JWT_SECRET=your_local_jwt_secret_change_this
JWT_EXPIRES_IN=18h

# ============================================
# CLOUDFLARE R2 STORAGE CONFIGURATION
# ============================================
# S3-compatible object storage for images, branch logos & PostgreSQL backups
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=kuwaitqumash-media
R2_PUBLIC_URL=https://media.yourdomain.com
R2_FOLDER=kuwaitqumash
BACKUP_RETENTION_DAYS=30

# ============================================
# PLATFORM ADMIN & PRODUCTION SIGNUP CONTROL
# ============================================
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=change_me_for_local_dev_only
ADMIN_JWT_SECRET=
# Public self-registration is permanently disabled; stores are provisioned via Admin Panel
ALLOW_PUBLIC_SIGNUP=false
TRUST_PROXY=1

# ============================================
# WHATSAPP WORKER & ANTI-BAN LIMITS
# ============================================
WA_SEPARATE_WORKER=true
# Auth storage: "file" (local volume, default) or "db" (PostgreSQL public.whatsapp_auth_states for multi-container scale)
WA_AUTH_STORAGE=file
WA_AUTH_DIR=./whatsapp_sessions
WA_BULK_DAILY_LIMIT=100
WA_WARMUP_HOURS=24
WA_WARMUP_DAILY_LIMIT=20
WA_QUIET_START_HOUR=9
WA_QUIET_END_HOUR=22

# ============================================
# OPENAI CONFIGURATION (Optional)
# ============================================
# For ID card scanning feature
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# ============================================
# CORS CONFIGURATION
# ============================================
# Comma-separated list of allowed frontend URLs
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# REDIS CONFIGURATION (Optional)
# ============================================
# For caching and rate limiting
# Leave as localhost for local dev
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# ============================================
# PAGINATION
# ============================================
MAX_PAGINATION_LIMIT=200

# ============================================
# LOGGING (Optional)
# ============================================
# Options: error, warn, info, debug
LOG_LEVEL=info

# ============================================
# PERFORMANCE TUNING (Optional)
# ============================================
# Global API rate limit per client IP
API_RATE_LIMIT_MAX=500
API_RATE_LIMIT_WINDOW_MS=60000
# Dashboard cache lifetime (seconds); invalidated on sale/refund anyway
DASHBOARD_CACHE_TTL_SECONDS=300
# Short-lived auth user profile cache in protect middleware (seconds; invalidated on logout/staff update)
AUTH_USER_CACHE_TTL_SECONDS=45
# Max active WhatsApp Baileys sockets held in RAM before LRU eviction (auto-reconnects on demand)
WHATSAPP_MAX_ACTIVE_SESSIONS=40
# Optional idle session eviction TTL in milliseconds (0 = disabled)
WHATSAPP_IDLE_SESSION_TTL_MS=0
# Hard cap for a single Excel export
SALES_EXCEL_MAX_ROWS=20000
