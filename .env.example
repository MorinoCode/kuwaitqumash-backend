# ============================================
# BACKEND ENVIRONMENT VARIABLES TEMPLATE
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git! (it's already in .gitignore)
#
# For local development:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your actual values
#   3. Start the server: npm run dev
#
# For production (Cloud Run):
#   - Environment variables are set in Cloud Run console
#   - Or via deploy-cloudrun.ps1 script
# ============================================

# ============================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================
# Local: Use localhost
# Production: Use Cloud SQL connection string
DB_NAME=kuwaitqumash_db
DB_USER=postgres
DB_PASS=your_local_database_password
DB_HOST=localhost
DB_PORT=5432

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# JWT CONFIGURATION (REQUIRED)
# ============================================
# Use a strong random secret for production!
JWT_SECRET=your_local_jwt_secret_change_this
JWT_EXPIRES_IN=18h

# ============================================
# CLOUDINARY CONFIGURATION (REQUIRED)
# ============================================
# For image/file uploads
# Get these from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=kuwaitqumash
USE_CLOUD_STORAGE=false

# ============================================
# OPENAI CONFIGURATION (Optional)
# ============================================
# For ID card scanning feature
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# ============================================
# CORS CONFIGURATION
# ============================================
# Comma-separated list of allowed frontend URLs
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# REDIS CONFIGURATION (Optional)
# ============================================
# For caching and rate limiting
# Leave as localhost for local dev
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# ============================================
# PAGINATION
# ============================================
MAX_PAGINATION_LIMIT=200

# ============================================
# LOGGING (Optional)
# ============================================
# Options: error, warn, info, debug
LOG_LEVEL=info

# ============================================
# PERFORMANCE TUNING (Optional)
# ============================================
# Global API rate limit per client IP
API_RATE_LIMIT_MAX=500
API_RATE_LIMIT_WINDOW_MS=60000
# Dashboard cache lifetime (seconds); invalidated on sale/refund anyway
DASHBOARD_CACHE_TTL_SECONDS=300
# Hard cap for a single Excel export
SALES_EXCEL_MAX_ROWS=20000
