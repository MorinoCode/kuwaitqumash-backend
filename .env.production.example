# Production Environment Variables Example
# Copy this file to .env.production and fill in your values
# NEVER commit .env.production to git!

# Database Configuration
# ⚠️ IMPORTANT: DB_HOST must NOT be "localhost" on Cloud Run!
# Options:
#   1. Cloud SQL: DB_HOST=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME
#   2. External IP: DB_HOST=10.123.45.67 (use VPC Connector if needed)
#   3. Public IP: DB_HOST=your-db-public-ip (less secure)
DB_NAME=gold_db
DB_USER=postgres
DB_PASS=YOUR_SECURE_PASSWORD_HERE
DB_HOST=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME
DB_PORT=5432

# Database Requirement (optional)
# Set to "true" to exit if DB connection fails on startup
# Default: false (server starts even if DB is down - useful for graceful degradation)
REQUIRE_DB=false

# Server Configuration
PORT=8080
NODE_ENV=production

# JWT Configuration
JWT_SECRET=YOUR_VERY_SECURE_RANDOM_SECRET_HERE_MAKE_IT_LONG_AND_RANDOM
JWT_EXPIRES_IN=18h

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=gold_inventory_app
USE_CLOUD_STORAGE=true

# Gold API Configuration
GOLD_API_KEY=your_gold_api_key
GOLD_API_URL=https://www.goldapi.io/api

# OpenAI Configuration (Optional)
OPENAI_API_KEY=your_openai_key

# CORS Configuration
CORS_ORIGINS=https://your-frontend-url.run.app

# Redis Configuration (Optional)
# ⚠️ IMPORTANT: Must NOT be "localhost" on Cloud Run!
# Options:
#   1. Cloud Memorystore: redis://10.123.45.67:6379 (internal IP)
#   2. External Redis: redis://your-redis-host:6379
#   3. Leave empty if not using Redis
REDIS_URL=redis://your-redis-host:6379

# WhatsApp Sessions Storage (Production)
# در production، WhatsApp sessions باید در Cloud Storage نگه داشته شوند
# چون container ephemeral است و بعد از هر deploy فایل‌های local از بین می‌روند
USE_GCS_FOR_WHATSAPP=true
GCP_PROJECT_ID=kuwiatgoldpro
WHATSAPP_SESSIONS_BUCKET=kuwiatgoldpro-whatsapp-sessions

# Pagination
MAX_PAGINATION_LIMIT=200
