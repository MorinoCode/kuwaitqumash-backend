# Production Environment Variables Example (Oracle Cloud + Docker Compose)
# Copy this file to .env on the server and fill in real production secrets.
# NEVER commit production .env files to git.

# Docker Image published to GitHub Container Registry (lowercase!)
BACKEND_IMAGE=ghcr.io/YOUR_GITHUB_USERNAME/kuwaitqumash-backend:latest

# PostgreSQL Database Configuration
DB_NAME=kuwaitqumash_db
DB_USER=kuwaitqumash
DB_PASS=CHANGE_TO_STRONG_RANDOM_PASSWORD
DB_HOST=postgres
DB_PORT=5432
REQUIRE_DB=true

# Express Server Configuration
PORT=8080
NODE_ENV=production
TRUST_PROXY=1

# Store Auth JWT Configuration
JWT_SECRET=CHANGE_TO_LONG_RANDOM_64_CHAR_HEX_SECRET
JWT_EXPIRES_IN=24h

# Platform Admin Panel Auth (/api/admin/*)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD_HASH=$2b$10$REPLACE_WITH_BCRYPT_HASH_OF_ADMIN_PASSWORD
ADMIN_JWT_SECRET=CHANGE_TO_SEPARATE_64_CHAR_HEX_SECRET
ALLOW_PUBLIC_SIGNUP=false

# Cloudflare R2 Storage (Images, Logos & PostgreSQL Backups)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=kuwaitqumash-media
R2_PUBLIC_URL=https://media.yourdomain.com
R2_FOLDER=kuwaitqumash
R2_BACKUP_BUCKET_NAME=kuwaitqumash-backups
R2_BACKUP_PREFIX=backups/postgres
BACKUP_RETENTION_DAYS=30

# CORS Configuration (Vercel / Cloudflare Pages URLs)
CORS_ORIGINS=https://qummash.vercel.app,https://kuwaitqumash-frontend.vercel.app,https://kuwaitqumash-admin.vercel.app

# Redis Configuration (Required for tenant cache, token revocation, BullMQ queues & WhatsApp worker)
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379

# WhatsApp Worker & Anti-Ban Protection
WA_SEPARATE_WORKER=true
WA_AUTH_DIR=/app/whatsapp_sessions
WA_RECONNECT_STAGGER_MS=2000
WA_BULK_DAILY_LIMIT=100
WA_WARMUP_HOURS=24
WA_WARMUP_DAILY_LIMIT=20
WA_QUIET_START_HOUR=9
WA_QUIET_END_HOUR=22

# Pagination
MAX_PAGINATION_LIMIT=200
